{
  "name": "dsh-chat-spacing",
  "description": "DSH chat spacing plugin: unifies the conversation flow gap and the indent, margins, card borders and radii of expanded reasoning / tool-call bodies, with live steppers in Settings. Browser-only UI, removable, no core changes.",
  "version": "0.2.3",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "ui",
    "spacing",
    "css",
    "chat"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js"
  ],
  "scripts": {
    "bundle": "echo noop: plain JS client bundle; edit lib/client.js directly"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-locale": "^0.1.1-rc.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imcaibaicai/dsh-chat-spacing.git"
  }
}
